# ─────────────────────────────────────────────
# MyWebStack – .gitignore
# ─────────────────────────────────────────────

# Extracted components (generated by setup.ps1 from packages/*.zip)
apache/Apache24/
php/*/
mysql/mysql-*/

# MySQL runtime data
mysql/*/data/

# phpMyAdmin (download separately – see CONTRIBUTING.md)
packages/phpmyadmin/
phpmyadmin/

# Generated runtime configs (written by setup.ps1)
apache/Apache24/conf/httpd.conf
php/*/php.ini
mysql/*/my.ini

# Logs
logs/
apache/Apache24/logs/
mysql/*/data/*.log
mysql/*/data/*.err

# User web projects (each developer has their own)
www/*/
!www/.gitkeep

# Large binary packages (contributors download separately)
packages/*.zip

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.lnk
.vscode/
.idea/
*.suo
*.user
